# ── Formulario de contacto ────────────────────────────────────────────────
# Envío de correos con Resend (https://resend.com). El dominio del remitente
# (headline.cl) debe estar verificado en Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Headline <web@headline.cl>"
# Destinatario de las notificaciones (por defecto headline@headline.cl).
CONTACT_TO_EMAIL=headline@headline.cl
# Copia oculta (separar varias con coma). Dejar vacío para desactivarla.
CONTACT_BCC_EMAIL=contacto@srweb.cl

# reCAPTCHA v3 (https://www.google.com/recaptcha/admin). La clave de sitio es
# pública; la clave secreta nunca debe subirse al repositorio.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Puntaje mínimo aceptado (0 a 1). Por defecto 0.5.
RECAPTCHA_MIN_SCORE=0.5

# ── Publicidad (opcional) ─────────────────────────────────────────────────
# Al definir alguno, el sitio muestra el aviso de cookies y carga el script
# sólo si el visitante acepta. Sin valores, no se carga nada.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Etiqueta de la conversión del formulario en Google Ads (AW-XXX/etiqueta).
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
